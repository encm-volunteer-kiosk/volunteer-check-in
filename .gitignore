# Real ENCM volunteer data (names, DOB, addresses, emergency contacts). Never commit.
data/
*.xlsx
*.ods
*.csv
# Invented sample data with the real column headers is the one exception.
!sample-data/*.csv

# ENCM brand files and onboarding PDF templates. Add specific images when the UI needs them.
assets/
# The kiosk's own images, imported by the front end.
!/src/assets/

# Build outputs: the single-file kiosk page and the copy doGet serves.
dist-gas/
apps-script/Index.html

# clasp keeps credentials in ~/.clasprc.json; never copy them here.
.clasprc.json
node_modules/
.DS_Store
# Browser snapshots from playwright-cli.
.playwright-cli/

# From the Figma Make export
node_modules/
dist/
build/
.cache/
.env*
.vite/
vite.config.*.timestamp-*
*.tsbuildinfo
*-debug.log*
logs/
*.log
.claude-replay.*
.tmp-*
/.figma/design-context/

# Platform-managed agentplat state, not project source. In the
# client-initiated single-repo workspace layout (make's `Path: "."` spec) the
# repo root IS the workspace root, so these land inside this repo rather than
# beside it.
/.plugins/
/.opencode-skills/
